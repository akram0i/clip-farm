{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipfarm.local/contracts/campaign-dispatch.schema.json",
  "title": "ClipFarm campaign dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "campaign_name",
    "episode_url",
    "platforms",
    "requirements"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "format": "uuid" },
    "campaign_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "episode_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["tiktok", "instagram", "youtube", "x"] }
    },
    "requirements": { "type": "string", "minLength": 1, "maxLength": 30000 },
    "available_content": { "type": "string", "maxLength": 30000, "default": "" },
    "reward_rate": { "type": ["number", "null"], "minimum": 0 },
    "minimum_payout": { "type": ["number", "null"], "minimum": 0 },
    "maximum_payout": { "type": ["number", "null"], "minimum": 0 },
    "requested_by": {
      "type": "string",
      "maxLength": 100,
      "description": "Server-derived display snapshot. Never use this value for authorization."
    }
  }
}
